<Window x:Class="ComboBoxApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="clr-namespace:System;assembly=System.Runtime"
        xmlns:local="clr-namespace:ComboBoxApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="#202020">
    <Window.Resources>
        <x:Array x:Key="FruitsList" Type="{x:Type s:String}">
            <s:String>Apple</s:String>
            <s:String>Berry</s:String>
            <s:String>Figs</s:String>
            <s:String>Grapes</s:String>
            <s:String>Kiwi</s:String>
            <s:String>Lichti</s:String>
            <s:String>Mango</s:String>
            <s:String>Orange</s:String>
        </x:Array>
    </Window.Resources>
    <StackPanel>
        <ComboBox IsEditable="True" MinWidth="200" Margin="5">
            <ComboBoxItem Content="Jack Daniels" IsSelected="True" />
            <ComboBoxItem Content="Baileys" />
            <ComboBoxItem Content="Merlot" />
            <ComboBoxItem Content="Bombay Sapphire" />
        </ComboBox>

        <ComboBox Width="200" ItemsSource="{StaticResource FruitsList}" Margin="5"/>
        <ComboBox Width="200" ItemsSource="{StaticResource FruitsList}" Margin="5" SelectedIndex="1"/>

        <ComboBox Height="50" Width="200" Margin="5" ItemsSource="{StaticResource FruitsList}" 
                  HorizontalAlignment="Right" HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom"/>

        <ComboBox ItemsSource="{StaticResource FruitsList}" Margin="5" SelectedIndex="4" IsReadOnly="True" Width="300" />
        <ComboBox ItemsSource="{StaticResource FruitsList}" Margin="5" SelectedIndex="4" IsReadOnly="True" IsEditable="True" Width="300" Height="50"/>
        <ComboBox ItemsSource="{StaticResource FruitsList}" Margin="5" SelectedIndex="4" IsEnabled="False" Width="300" />
        <ComboBox ItemsSource="{StaticResource FruitsList}" Margin="5" SelectedIndex="4" IsReadOnly="True" IsEnabled="False" Width="300" />
        <TextBox Text="Hello" Margin="5"/>
    </StackPanel>
</Window>
